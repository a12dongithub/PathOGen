# Ignore everything by default; this repository tracks source and experiment definitions only.
*

# Allow traversal into source directories.
!*/

# Root repository configuration.
!.gitignore

# Training source and environment definitions.
!training/**/*.py
!training/**/*.sh
!training/requirements-colab.txt

# Reproducible experiment launchers and documentation.
!experiments/**/*.py
!experiments/**/*.ipynb
!experiments/**/*.md
!experiments/requirements_fidelity.txt
!experiments/requirements_tables.txt

# Never track generated artifacts, caches, or checkpoints.
**/__pycache__/
**/*.pyc
**/.DS_Store
**/outputs/
**/results/
**/checkpoints/
**/*.zip

# Keep the documented Colab asset layout while ignoring every large payload.
!assets/
!assets/README.md
!assets/downloads/
!assets/downloads/README.md
!assets/data/
!assets/data/README.md
!assets/data/512_final_dataset/
!assets/data/512_final_dataset/README.md
!assets/checkpoints/
!assets/checkpoints/README.md
!assets/checkpoints/pathogen/
!assets/checkpoints/pathogen/README.md
!assets/checkpoints/pathogen/checkpoint-30000/
!assets/checkpoints/pathogen/checkpoint-30000/README.md
!assets/checkpoints/cellvit/
!assets/checkpoints/cellvit/README.md
!assets/external/
!assets/external/README.md
!assets/external/CellViT-plus-plus/
!assets/external/CellViT-plus-plus/README.md
assets/external/CellViT-plus-plus/repository/
!assets/outputs/
!assets/outputs/README.md
