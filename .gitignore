# Python and local environments
__pycache__/
*.pyc
.pytest_cache/
.mypy_cache/
.ruff_cache/
.venv/
venv/
*.egg-info/

# Editors and operating-system files
.DS_Store
Thumbs.db
*.swp
*.swo
.idea/
.vscode/

# Large or generated material; retain README placeholders and small manifests in Git
data/**
!data/**/
!data/**/README.md

# Small, aligned repository fixture used by workflows 01, 02, and 05
!data/interim/tiles/tcga_brca/*.png
!data/interim/annotations/
!data/interim/annotations/tcga_brca/
!data/interim/annotations/tcga_brca/geojson/
!data/interim/annotations/tcga_brca/geojson/*.geojson
!data/processed/conditions/metadata.jsonl
!data/processed/conditions/spatial_maps/*.npz
!data/processed/conditions/morphology/feature_manifest.json
!data/processed/conditions/morphology/standardized.parquet

artifacts/**
!artifacts/**/
!artifacts/**/README.md

# Track archived source/docs, but not archived datasets, models, results, smoke
# outputs, administrative records, or unclassified binary remnants.
archive/*
!archive/README.md
!archive/code/
!archive/code/**
!archive/configs/
!archive/configs/**
!archive/docs/
!archive/docs/**
!archive/experiments/
!archive/experiments/**
!archive/legacy_code/
!archive/legacy_code/**
!archive/notebooks/
!archive/notebooks/**
!archive/tests/
!archive/tests/**
!archive/third_party/
!archive/third_party/**
!archive/tools/
!archive/tools/**
*.pt
*.pth
*.ckpt
*.safetensors
*.joblib
*.zip

# Local logs and secrets
*.log
.env
.env.*
